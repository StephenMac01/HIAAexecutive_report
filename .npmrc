# Use a flat, npm-style node_modules layout instead of pnpm's default
# symlinked/isolated store.
#
# Why: Next.js `output: "standalone"` traces the runtime dependency closure
# with @vercel/nft. With pnpm's isolated layout, the tracer misses several of
# Next's own runtime deps (@swc/helpers, styled-jsx, tslib, scheduler, ...), so
# they never get copied into `.next/standalone/node_modules`. It still boots
# locally (Node resolves them from the surrounding workspace) but crashes with
# MODULE_NOT_FOUND when the standalone bundle is deployed in isolation (e.g.
# Azure App Service) -> 503.
#
# A hoisted layout makes pnpm behave like npm, which the tracer handles
# correctly, so the standalone output is complete and self-contained.
node-linker=hoisted
