# CNS HIAA KPI Dashboard — environment variables (PLACEHOLDERS ONLY)
# Copy to `.env.local` and fill in real values. Never commit real secrets.
#
# With NONE of these set, the app runs fully on the bundled local fallback
# workbooks (data/kpi-NN/kpi-NN.xlsx) — useful for dev/preview.

# --- SharePoint / Microsoft Graph (app-only client credentials) ------------
# Required together to read workbooks live from SharePoint. If any is missing,
# the app falls back to the local workbooks.
SHAREPOINT_TENANT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_CLIENT_SECRET=your-entra-app-client-secret
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/HIAAKPIs

# Optional sub-folder inside the document library (e.g. a Teams channel folder).
# Leave blank if workbooks live at the library root.
SHAREPOINT_BASE_PATH=

# Optional workbook layout. Default is folder-per-KPI: "{id}/{id}.xlsx"
# → kpi-01/kpi-01.xlsx. Use "{id}.xlsx" for a flat library.
SHAREPOINT_FILE_TEMPLATE={id}/{id}.xlsx

# Optional Graph download tuning.
SHAREPOINT_TIMEOUT_MS=15000
SHAREPOINT_MAX_RETRIES=3

# --- Caching ---------------------------------------------------------------
# ISR window (seconds) for a KPI workbook fetch. High (300) when using the
# webhook; low (60) for poll-only refresh. Legacy alias: KPI_CACHE_SECONDS.
KPI_CACHE_TTL_SECONDS=300

# --- Refresh webhook -------------------------------------------------------
# Shared secret required to POST /api/revalidate (and for /api/health?deep=1).
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=change-me-to-a-long-random-string

# --- Notifications: database (Azure Database for PostgreSQL Flexible Server) -
# PRODUCTION server: cns-hiaa-kpi-pg-prod (Azure Canada Central/East).
# Data residency: this app must NOT use any non-Canadian database (e.g. Neon).
# The code targets Azure PostgreSQL Flexible Server exclusively — it reads only
# DATABASE_URL, so pointing this at cns-hiaa-kpi-pg-prod is the entire switch.
# Standard PostgreSQL wire protocol; TLS is always required (enforced in code).
#
# Option A — password auth (simplest; good for local/dev):
DATABASE_URL=postgres://dbadmin:PASSWORD@cns-hiaa-kpi-pg-prod.postgres.database.azure.com:5432/kpi?sslmode=require
#
# Option B — Microsoft Entra ID auth (recommended for production). Omit the
# password from DATABASE_URL and set the user to the Entra principal; the app's
# managed identity fetches a short-lived token per connection.
#   DATABASE_URL=postgres://app-identity@cns-hiaa-kpi-pg-prod.postgres.database.azure.com:5432/kpi?sslmode=require
#   AZURE_PG_USE_ENTRA=true
AZURE_PG_USE_ENTRA=false
#
# Optional: pin a CA bundle (inline PEM or a file path) for verify-full TLS.
# Leave blank to verify against Node's built-in trust store (works with Azure).
AZURE_PG_SSL_CA=

# --- Authentication: Microsoft Entra ID via App Service Easy Auth ----------
# Production auth is handled by Azure App Service Authentication ("Easy Auth"):
# enable it on the App Service, register/point it at your Entra app, and define
# App Roles (Admin / Manager / Viewer) assigned to users or groups. No secrets
# are needed in the app — Easy Auth injects the validated principal as request
# headers, which the app reads (see lib/auth/easy-auth.ts). Roles map by name:
# any role containing "admin" -> admin, "manager" -> manager, else viewer.
#
# Set to "true" in production to force login (the proxy redirects unauthenticated
# page requests to Entra). Leave false locally / in preview, where there is no
# Easy Auth in front of the app and the dev identity below is used instead.
AUTH_REQUIRE_ENTRA=false

# --- Authentication: local dev fallback identity ---------------------------
# Used ONLY when no Easy Auth principal header is present (local dev / preview).
# Ignored in production once a real Entra user is signed in.
NOTIFY_DEV_USER_ID=dev-user
NOTIFY_DEV_USER_EMAIL=stephen.macneil@example.com
NOTIFY_DEV_USER_NAME=Stephen MacNeil
NOTIFY_DEV_USER_ROLE=admin

# --- Notifications: evaluation trigger -------------------------------------
# Shared secret required to POST /api/notifications/evaluate (scheduler/webhook).
# Generate with: openssl rand -base64 32
NOTIFY_EVALUATE_SECRET=change-me-to-a-long-random-string

# --- Notifications: delivery channels (Phase 3+) ---------------------------
# Dashboard delivery is always on. Email/Teams are stubbed until these are
# turned on AND Graph send permissions + a sender are configured.
NOTIFY_EMAIL_ENABLED=false
NOTIFY_TEAMS_ENABLED=false
